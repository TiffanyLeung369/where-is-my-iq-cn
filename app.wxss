@keyframes confetti-fall {
  0% {
    transform: translateY(-80rpx) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(900rpx) rotate(1080deg);
    opacity: 0;
  }
}

/* ========== 礼炮喷射粒子 ========== */
.cannon-container {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 10;
}

.cannon-particle {
  position: absolute;
  bottom: -20rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  opacity: 0;
  animation-fill-mode: forwards;
}

/* 左下角礼炮：密集、细小、高速向右上方喷射 */
@keyframes shoot-left {
  0% { transform: translate(0, 0) scale(0.3) rotate(0deg); opacity: 1; }
  60% { opacity: 1; }
  100% { transform: translate(var(--tx), var(--ty)) scale(1) rotate(var(--rot)); opacity: 0; }
}

