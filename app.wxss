/* ========== 通用资产胶囊 (全局) ========== */
.asset-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}

.asset-icon {
  width: 50rpx;
  height: 50rpx;
}

.asset-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c5f7c;
}

.asset-plus {
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4FC3F7, #2196F3);
  border-radius: 50%;
  margin-left: 4rpx;
}

.asset-item:active {
  transform: scale(0.95);
  opacity: 0.8;
}
