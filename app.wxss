/* ========== 全局样式 ========== */

page {
  background-color: #BBEBFF; /* 原来是 #d4eef7，现在替换为更明亮活泼清透亮丽的蓝色 */
  color: #2c5f7c;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  overflow: hidden;
}

/* ========== 通用工具类 ========== */

.pencil-icon {
  border-radius: 8rpx;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.text-shadow {
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* ========== 按钮通用样式 ========== */

.btn-primary {
  background: linear-gradient(135deg, #FF6B6B, #FF8E53);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 80rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.btn-secondary {
  background: linear-gradient(135deg, #D4FAFF, #8ADEFF); /* 改用海洋主题的明亮蓝渐变，摒弃惨白 */
  color: #2c5f7c;
  border: none; /* 原本为了白色外挂的边框去除了，保持扁平圆润渐变 */
  border-radius: 50rpx;
  padding: 22rpx 60rpx; /* 取消border后高度找补回来一点 */
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.btn-secondary:active {
  transform: scale(0.95);
  background: #ffffff;
}

/* ========== 动画 ========== */

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes bounceIn {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-8rpx); }
  40%, 80% { transform: translateX(8rpx); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.animate-fadeIn {
  animation: fadeIn 0.5s ease forwards;
}

.animate-bounceIn {
  animation: bounceIn 0.4s ease forwards;
}

.animate-shake {
  animation: shake 0.4s ease;
}

.animate-pulse {
  animation: pulse 0.6s ease infinite;
}
/* ========== 全局体力不足弹窗 (010图) ========== */
.stamina-modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.stamina-m-card {
  width: 580rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.2);
}

.stamina-m-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #4a668c;
  margin-bottom: 12rpx;
}

.stamina-m-sub {
  font-size: 28rpx;
  color: #8da1b9;
  margin-bottom: 30rpx;
}

.stamina-m-banner {
  width: 100%;
  background: linear-gradient(180deg, #ffbb00, #ff9500);
  border-radius: 30rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 10rpx 20rpx rgba(255, 149, 0, 0.3);
  margin-bottom: 40rpx;
}

.stamina-m-icons {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.stamina-m-shell {
  width: 100rpx;
  height: 100rpx;
  margin-right: -10rpx;
  z-index: 10;
  filter: drop-shadow(4rpx 4rpx 0px rgba(0,0,0,0.2));
}
.stamina-m-val {
  font-size: 80rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: -2rpx -2rpx 0 #5b799e, 2rpx -2rpx 0 #5b799e, -2rpx 2rpx 0 #5b799e, 2rpx 2rpx 0 #5b799e, 0 6rpx 0 #5b799e;
}

.stamina-m-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: bold;
}

.stamina-btn-ad, .stamina-btn-share {
  width: 440rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 26rpx;
  padding: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
}
.stamina-btn-ad { background: #3982f6; }
.stamina-btn-share { background: #56c243; }

.pulse-wrapper {
  position: relative;
  overflow: visible; /* 必须 visible 让悬浮红角标能出框 */
}

/* 完美移植角标律动 */
.pulse-corner {
  position: absolute;
  top: -16rpx;
  right: 10rpx;
  width: 64rpx;
  height: 64rpx;
  transform: rotate(12deg);
  animation: bounceAd 2s infinite ease-in-out;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
  z-index: 5;
}
@keyframes bounceAd {
  0%, 100% { transform: translateY(0) rotate(12deg) scale(1); }
  50% { transform: translateY(-8rpx) rotate(18deg) scale(1.08); }
}

.s-btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

/* 纯 CSS 还原经典微信分享图腾节点网络 */
.svg-share-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 14rpx;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' fill='none' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='18' cy='5' r='3'/%3E%3Ccircle cx='6' cy='12' r='3'/%3E%3Ccircle cx='18' cy='19' r='3'/%3E%3Cline x1='8.59' y1='13.51' x2='15.42' y2='17.49'/%3E%3Cline x1='15.41' y1='6.51' x2='8.59' y2='10.49'/%3E%3C/svg%3E");
  background-size: cover;
  background-repeat: no-repeat;
  display: inline-block;
}

.s-btn-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.stamina-m-footer {
  font-size: 28rpx;
  color: #5B799E;
  font-weight: bold;
  margin-top: 14rpx;
}

.stamina-close-btn {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.8);
  font-size: 40rpx;
  font-weight: bold;
  margin-top: 50rpx;
}

/* 彩带粒子 */
.confetti-container {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.confetti {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  opacity: 0;
  animation: confetti-fall 2.5s ease-out infinite;
}

